{
  "manifest_version": 3,
  "name": "Sello",
  "version": "0.1.0",
  "key": "",
  "description": "Sello de confianza sobre Gmail. Analiza el correo abierto sin pedir otra sesión.",
  "icons": {
    "16": "icons/pumpkin.svg",
    "32": "icons/pumpkin.svg",
    "48": "icons/pumpkin.svg",
    "128": "icons/pumpkin.svg"
  },
  "action": {
    "default_title": "Sello",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pumpkin.svg",
      "32": "icons/pumpkin.svg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://mail.google.com/*"]
}
