<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\web\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\examples\**\*" Link="examples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\SafeUpdate.Analyzers\SafeUpdate.Analyzers.csproj" />
    <ProjectReference Include="..\SafeUpdate.Application\SafeUpdate.Application.csproj" />
    <ProjectReference Include="..\SafeUpdate.Infrastructure\SafeUpdate.Infrastructure.csproj" />
  </ItemGroup>
</Project>
