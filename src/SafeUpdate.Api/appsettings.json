{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SafeUpdate": {
    "MaxUploadBytes": 33554432,
    "MaxFileNameLength": 200,
    "UploadRoot": "data/uploads",
    "UploadRetentionHours": 24,
    "ApiKey": "",
    "AnalysisTimeoutSeconds": 120
  }
}
